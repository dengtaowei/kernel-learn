flowchart TB
    subgraph DT["设备树 (DTS)"]
        N1["pinctrl 状态节点<br/>i2c1_pins_a: i2c1-0"]
        N2["pins 子节点"]
        P1["pinmux = STM32_PINMUX('F',14,AF5)<br/>→ u32: 0x5E06 (pin=94, func=6)"]
        P2["可选 pinconf"]
        N1 --> N2 --> P1
        N2 --> P2
    end

    subgraph PhaseA["阶段 A · probe · 生成 map"]
        A1["stm32_pctrl_dt_node_to_map"]
        A2["stm32_pctrl_dt_subnode_to_map"]
